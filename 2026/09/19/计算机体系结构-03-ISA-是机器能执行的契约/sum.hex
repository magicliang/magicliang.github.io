# Sum five 32-bit words at byte address 128 and store the result at 148.
.text
0x08000093  # addi x1,x0,128
0x00500113  # addi x2,x0,5
0x00000193  # addi x3,x0,0
0x0000a203  # lw   x4,0(x1)
0x004181b3  # add  x3,x3,x4
0x00408093  # addi x1,x1,4
0xfff10113  # addi x2,x2,-1
0xfe0118e3  # bne  x2,x0,-16
0x08302a23  # sw   x3,148(x0)
.data
128 3
132 4
136 5
140 6
144 7
