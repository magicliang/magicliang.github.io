### TS01 [time-series]
# prerequisite: time_series index; timestamp within configured bounds
# expected: create bounded time-series index
# execution: NOT_RUN
PUT /es-ts-lab-v1
{
  "settings": {
    "index.mode": "time_series",
    "index.routing_path": [
      "host"
    ],
    "index.time_series.start_time": "2026-10-08T00:00:00Z",
    "index.time_series.end_time": "2026-10-09T00:00:00Z"
  },
  "mappings": {
    "properties": {
      "@timestamp": {
        "type": "date"
      },
      "host": {
        "type": "keyword",
        "time_series_dimension": true
      },
      "cpu": {
        "type": "float",
        "time_series_metric": "gauge"
      },
      "requests": {
        "type": "long",
        "time_series_metric": "counter"
      }
    }
  }
}

